# Token entries: token or login:token, separated by commas.
SPEECHMATICS_TOKENS="login@example.com:replace-me,replace-me-too"
# enhanced: highest accuracy for a selected language.
# standard: faster processing and archival transcription.
# melia-1: MULTILANGUAGE, language switching; set LANGUAGE=multi.
# oak-1: MULTILANGUAGE, healthcare recordings; set LANGUAGE=multi.
SPEECHMATICS_MODEL=enhanced
# Use pl, en, etc. for enhanced/standard, or multi for melia-1/oak-1.
SPEECHMATICS_LANGUAGE=pl
# MCP can disable diarization through disableDiarization.
SPEECHMATICS_DIARIZATION=speaker
# Audio events are supported by enhanced/standard.
SPEECHMATICS_AUDIO_EVENTS=true
SPEECHMATICS_CONVERT_TO_MP3=false
# Upload and processing timeout, independent of recording duration.
SPEECHMATICS_TIMEOUT_SECONDS=900
