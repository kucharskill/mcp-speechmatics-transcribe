# Wpisy token lub login:token. Konta rozdzielaj przecinkiem.
SPEECHMATICS_TOKENS="login@example.com:replace-me,replace-me-too"
# enhanced: najwyższa dokładność dla wybranego języka.
# standard: szybsze przetwarzanie, archiwizacja.
# melia-1: MULTILANGUAGE, zmiany języka w nagraniu; ustaw LANGUAGE=multi.
# oak-1: MULTILANGUAGE, nagrania medyczne; ustaw LANGUAGE=multi.
SPEECHMATICS_MODEL=enhanced
# pl, en itp. dla enhanced/standard; multi dla melia-1/oak-1.
SPEECHMATICS_LANGUAGE=pl
# Agent może jedynie wyłączyć diarizację przez disableDiarization.
SPEECHMATICS_DIARIZATION=speaker
# Zdarzenia są obsługiwane przez enhanced/standard.
SPEECHMATICS_AUDIO_EVENTS=true
# Konwersja wejścia innego niż MP3 przez FFmpeg.
SPEECHMATICS_CONVERT_TO_MP3=false
# Limit oczekiwania na API w sekundach, niezależny od długości nagrania.
SPEECHMATICS_TIMEOUT_SECONDS=900
